  burnDegree: Second Degree
  burnCause: Thermal Contact
  whatItLooks: Blisters, moist red skin, wet appearance.
  causes: Scalding water, flames, chemical contact.
  symptoms: Severe pain, swelling, fluid-filled blisters.
  emergency: Call 999 if larger than the palm of your hand.
  annotations: []
  treatmentSteps:
  - title: Remove Accessories
    instruction: Remove any watches or jewellery near the burn
    stepType: 0
  - title: Cool the Burn
    instruction: Run cool water over the burn for 20 minutes
    stepType: 1
  - title: Cover the Burn
    instruction: Pick up the bandage and wrap around the burn
    stepType: 6
