  m_Script: {fileID: 11500000, guid: 411783ed7ae238c43aa9f0f2aed96c04, type: 3}
  m_Name: Q4
  m_EditorClassIdentifier: 
  category: What Not To Do
  questionText: 'Q: Why should you NOT burst burn blisters? '
  options:
  - It is too painful
  - It increases infection risk
  - It slows healing
  correctIndex: 2
  explanation: Blisters protect the wound. Bursting them exposes raw tissue to bacteria
    and slows recovery.
