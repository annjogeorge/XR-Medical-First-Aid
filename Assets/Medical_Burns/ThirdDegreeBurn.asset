  m_Script: {fileID: 11500000, guid: 9c08442c47dd6244b99824e1db4ab624, type: 3}
  m_Name: ThirdDegreeBurn
  m_EditorClassIdentifier: 
  burnDegree: Third Degree
  burnCause: Prolonged Fire / Electrical / Chemical
  whatItLooks: White, brown or black skin. Leathery dry texture. Possible charring.
  causes: House fires, electrical accidents, prolonged chemical exposure.
  symptoms: No pain due to nerve damage. Charring visible. Skin looks waxy.
  emergency: Always call 999 immediately. Do not attempt to treat alone.
  annotations:
  - label: Charred skin
    localOffset: {x: 0, y: 0.01, z: 0}
  - label: No Pain Felt
    localOffset: {x: 0.02, y: 0.01, z: 0}
  - label: White or black
    localOffset: {x: -0.02, y: 0.01, z: 0}
  - label: Skin Destruction
    localOffset: {x: 0, y: 0.01, z: 0.02}
  treatmentSteps:
  - title: Call 999
    instruction: 'Call emergency services immediately '
    stepType: 5
  - title: Do not remove clothing
    instruction: Leave all clothing in place. Removing it causes further damage
    stepType: 6
  - title: Cover Loosely
    instruction: Cover loosely with cling film. Do NOT apply water to this burn.
    stepType: 3
  decalMaterial: {fileID: 2100000, guid: cbffb9252ec8d824bb1271f9f3341117, type: 2}
  requiresImmediate999: 1
