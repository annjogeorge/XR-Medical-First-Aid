  m_Script: {fileID: 11500000, guid: 9c08442c47dd6244b99824e1db4ab624, type: 3}
  m_Name: FirstDegreeBurn
  m_EditorClassIdentifier: 
  burnDegree: First Degree
  burnCause: Minor Heat/Sun Burn
  whatItLooks: Pink or red skin, dry surface, no blisters present.
  causes: Sunburn, brief contact with hot surface or steam.
  symptoms: Sunburn, brief contact with hot surface or steam.
  emergency: Not required unless burn covers a large area of the body.
  annotations: []
  treatmentSteps:
  - title: Cool the Burn
    instruction: "Run cool water over the burn for 10 minutes.\nPoint at the burn
      and press grab then turn on tap according to animation \n\n"
    stepType: 1
  - title: Apply Moisturiser
    instruction: Gently apply aloe vera or a moisturising lotion.
    stepType: 4
